# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Прод: задать HTTPS и один канон (www или apex), совпадающий с 301 в next.config/хостинге.
# NEXT_PUBLIC_SITE_URL=https://ваш-домен.ru
NEXT_PUBLIC_SITE_DOMAIN=example.com
NEXT_PUBLIC_BRAND_NAME=АПВ - СИСТЕМА
# Юрлицо (ИП) — значения по умолчанию совпадают с src/config/site.ts; в проде можно продублировать в .env.local
NEXT_PUBLIC_LEGAL_ENTITY_NAME="ИНДИВИДУАЛЬНЫЙ ПРЕДПРИНИМАТЕЛЬ МАХМАДОВ ШАРИФХОН ТАГАЙМУРОДОВИЧ"
NEXT_PUBLIC_INN=773424696359
# ОГРНИП
NEXT_PUBLIC_OGRN=325508100185182
NEXT_PUBLIC_LEGAL_ADDRESS="140125, Россия, Московская обл., г. Люберцы, мкр. Новые Островцы (д. Островцы), ул. Лётчика Волчкова, д. 2, кв. 155"
NEXT_PUBLIC_CHECKING_ACCOUNT=40802810200008139336
NEXT_PUBLIC_BANK_NAME="АО «ТБанк»"
NEXT_PUBLIC_BANK_INN=7710140679
NEXT_PUBLIC_BIK=044525974
NEXT_PUBLIC_CORRESPONDENT_ACCOUNT=30101810145250000974
NEXT_PUBLIC_BANK_LEGAL_ADDRESS="127287, г. Москва, ул. Хуторская 2-я, д. 38А, стр. 26"
NEXT_PUBLIC_PHONE="+7 (925) 437-12-11"
NEXT_PUBLIC_EMAIL_HELLO=mahmadov.personal@yandex.ru
NEXT_PUBLIC_EMAIL_SALES=mahmadov.personal@yandex.ru
NEXT_PUBLIC_TELEGRAM=https://t.me/LVHanter
NEXT_PUBLIC_WHATSAPP=https://wa.me/79254371211
# Ссылка MAX (профиль max.ru/u/…). Переопределяет дефолт из src/config/site.ts при необходимости.
# NEXT_PUBLIC_MAX=https://max.ru/u/…
# Исходящая почта для автоматического черновика КП (PDF после заявки). Без этих переменных PDF не отправляется.
# Можно перенести настройки из проекта StaffSonar: значения те же, имена — ниже.
#   StaffSonar            →  apv-b2b-landing
#   SMTP_PASS             →  SMTP_PASSWORD
#   EMAIL_FROM            →  MAIL_FROM
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=mahmadov.personal@yandex.ru
# SMTP_PASSWORD=
# Опционально: подпись отправителя и скрытые копии на черновик КП (тот же PDF, что клиенту)
# MAIL_FROM="АПВ - СИСТЕМА <mahmadov.personal@yandex.ru>"
# SMTP_BCC=
# Уведомление админу при отправке черновика КП (можно несколько через запятую)
# ADMIN_KP_NOTIFY_EMAIL=you@gmail.com
# Маркировка интернет-рекламы (ЕРИР): после выдачи erid в ОРД подставьте сюда — в подвале сайта появится строка «Реклама · erid: …»
NEXT_PUBLIC_AD_ERID=ERID-TBD
# Верификация вебмастеров (опционально)
# Яндекс (опционально): ключ JS API карт v3 — только если понадобится кастомная карта вместо виджета iframe в коде.
# NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
DEFAULT_TENANT_DOMAIN=localhost:3000
DEFAULT_TENANT_SLUG=default

# Верификация сайта в поиске (мета-теги в <head>, см. src/app/[locale]/layout.tsx)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=

# Яндекс OAuth — только для скриптов/API Вебмастера (не для верификации сайта).
# Реальные значения храни в deploy/.yandex-oauth.local.env (gitignored), см. deploy/yandex-oauth.env.example и deploy/README-NO-DOCKER.md
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=

# Database
DATABASE_URL=postgresql://apv:apv@localhost:5432/apv?schema=public

# Redis (cache, rate limit, BullMQ). Для прод-лимитов чата AI (`/api/site-assistant`) желателен рабочий REDIS_URL.
REDIS_URL=redis://localhost:6379

# Object storage (Timeweb / Yandex S3-compatible) — заглушки до продакшена
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CRM / comms (заглушки)
AMOCRM_BASE_URL=
AMOCRM_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Яндекс.Метрика — номер счётчика (виджет tag.js + reachGoal). Задаётся ДО сборки: попадает в клиентский бандл.
# Создай счётчик на https://metrika.yandex.ru/ → вставь ID. Список JS-целей: src/config/yandex-metrica-js-goals.json + my-guide/YANDEX-METRIKA-GOALS.md
# На VPS: в .env.production + npm run build:vps (или пересборка при смене ID).
# NEXT_PUBLIC_YANDEX_METRICA_ID=
# По умолчанию в init включён ecommerce:"dataLayer" (под настройку «Электронная коммерция» в Метрике). Отключить:
# NEXT_PUBLIC_YANDEX_METRICA_ECOMMERCE=false

# GigaChat (AI)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# Чат-консультант на сайте (DeepSeek, см. Мой Лендинг web/.env.local)
DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Cloudflare Turnstile (бот-защита на /api/site-assistant). Задавайте оба или ни одного.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# JWT admin (минимум 32 символа в проде)
JWT_SECRET=dev-change-me-use-openssl-rand-base64-32
