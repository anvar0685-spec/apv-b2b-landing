    "eslint": "^8",
    "eslint-config-next": "14.2.18",
    "postcss": "^8",
    "prettier": "^3.5.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "to-ico": "^1.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
