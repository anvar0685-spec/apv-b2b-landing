    "metrica:counter": "node scripts/yandex-metrica.mjs counter",
    "metrica:goals-check": "node scripts/yandex-metrica.mjs goals-check",
    "metrica:goals-install": "node scripts/yandex-metrica.mjs goals-install",
    "gsc:auth-url": "node scripts/google-search-console.mjs auth-url",
    "gsc:auth-open": "node scripts/google-search-console.mjs auth-open",
    "gsc:auth-serve": "node scripts/google-search-console.mjs auth-serve",
    "gsc:exchange": "node scripts/google-search-console.mjs exchange",
    "gsc:exchange-file": "node scripts/google-search-console.mjs exchange-file",
    "gsc:sites": "node scripts/google-search-console.mjs sites",
    "gsc:sync": "node scripts/google-search-console.mjs sync",
    "gsc:sitemaps": "node scripts/google-search-console.mjs sitemaps",
    "gsc:audit": "node scripts/google-search-console.mjs audit",
    "gsc:inspect": "node scripts/google-search-console.mjs inspect",
    "gsc:inspect-file": "node scripts/google-search-console.mjs inspect-file",
    "gsc:inspect-all": "node scripts/google-search-console.mjs inspect-all",
    "gsc:analytics": "node scripts/google-search-console.mjs analytics",
    "gsc:routine": "node scripts/google-search-console.mjs routine",
    "gsc:report": "node scripts/google-search-console.mjs report",
    "seo:google": "npm run gsc:routine",
    "seo:routine": "npm run webmaster:sync && npm run gsc:routine",
    "seo:check": "node scripts/seo-full-check.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1034.0",
