{
  "name": "apv-b2b-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['.next','node_modules/.cache','.turbo'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch(e){if(e.code!=='ENOENT')throw e}})\"",
    "dev": "WATCHPACK_POLLING=true next dev",
    "dev:clean": "npm run clean && WATCHPACK_POLLING=true next dev",
    "build": "next build",
    "build:vps": "next build && bash deploy/copy-standalone-assets.sh",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"*.{ts,tsx,js,json,md}\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "generate:industrial-band-assets": "node scripts/generate-industrial-band-assets.mjs",
    "webmaster:auth-url": "node scripts/yandex-webmaster.mjs auth-url",
    "webmaster:auth-open": "node scripts/yandex-webmaster.mjs auth-open",
    "webmaster:exchange": "node scripts/yandex-webmaster.mjs exchange",
    "webmaster:exchange-file": "node scripts/yandex-webmaster.mjs exchange-file",
    "webmaster:sync": "node scripts/yandex-webmaster.mjs sync",
