    "bullmq": "^5.76.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "next": "14.2.18",
    "next-intl": "^4.9.1",
    "nodemailer": "^8.0.7",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.73.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
