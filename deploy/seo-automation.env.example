# Скопируй в deploy/.seo-automation.env.local (gitignored) при необходимости.

# Яндекс: макс. переобходов за один запуск (не выше остатка дневной квоты API).
SEO_YANDEX_RECRAWL_MAX=40
SEO_RECRAWL_DELAY_MS=500

# Google GSC: макс. URL Inspection за запуск.
SEO_GSC_INSPECT_MAX=15
SEO_GSC_INSPECT_DELAY_MS=600
SEO_GSC_ANALYTICS_INTERVAL_DAYS=7
