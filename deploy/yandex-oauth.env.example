# Скопируй в deploy/.yandex-oauth.local.env и заполни (файл .local — в .gitignore).
# Консоль: https://oauth.yandex.ru/ — тип приложения «Для доступа к API или отладки»,
# права: Яндекс.Вебмастер + **Яндекс.Метрика** (для scripts/yandex-metrica.mjs), Redirect URI: https://oauth.yandex.ru/verification_code
#
# Токены API (не коммитить). Удобнее code-flow → refresh:
#   npm run webmaster:auth-url
#   npm run webmaster:exchange -- <код_со_страницы_yandex>
#   npm run webmaster:sync
#
# Либо вручную access_token из implicit URL:
#   https://oauth.yandex.ru/authorize?response_type=token&client_id=<YANDEX_OAUTH_CLIENT_ID>

YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# YANDEX_METRICA_ACCESS_TOKEN=   # опционально: только для API Метрики (иначе см. metrica-oauth.env.example / общий WEBMASTER токен с metrika:read)
# YANDEX_OAUTH_REFRESH_TOKEN=
# WEBMASTER_SITEMAP_URL=https://xn----7sbbgqr3atubl.xn--p1ai/sitemap.xml
# WEBMASTER_RECRAWL_FILE=deploy/custom-recrawl.txt
# WEBMASTER_RECRAWL_LIMIT=10
