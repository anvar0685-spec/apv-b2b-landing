# Скопируй в deploy/.google-oauth.local.env и заполни (файл .local — в .gitignore).
#
# 1) Google Cloud Console → проект → APIs & Services:
#    - включи «Google Search Console API»
# 2) OAuth consent screen (External) + Audience → Test users = тот же Gmail, что в GSC (иначе 403 access_denied)
# 3) Credentials → OAuth client ID → «Desktop app» или «Web application»
#    Redirect URI (если Web): http://localhost:8765/oauth2/callback
#
# Первичная авторизация:
#   npm run gsc:auth-url
#   npm run gsc:auth-serve         # рекомендуется: браузер + авто-callback :8765
#   # или: auth-open → code в deploy/.google-oauth-code.local → exchange-file
#   npm run gsc:sites
#   npm run gsc:sync
#
# Сайт в GSC должен быть уже добавлен и подтверждён (мета-тег на сайте).

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_GSC_ACCESS_TOKEN=        # опционально; иначе refresh

# Свойство в GSC (URL-prefix с завершающим /):
# GSC_SITE_URL=https://апв-система.рф/
# Подбор по подстроке, если несколько свойств:
# GSC_SITE_MATCH=xn----7sbbgqr3atubl

# GSC_SITEMAP_URL=https://xn----7sbbgqr3atubl.xn--p1ai/sitemap.xml
# GSC_INSPECT_FILE=deploy/webmaster-recrawl-priority.txt
# GSC_INSPECT_LIMIT=5
